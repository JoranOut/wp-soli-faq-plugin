#. Plugin Name of the plugin
#: wp-soli-faq-plugin.php
msgid "Soli FAQ Plugin"
msgstr "Soli FAQ Plugin"

#. Description of the plugin
#: wp-soli-faq-plugin.php
msgid "Members-only frequently asked questions (FAQs) post type for Soli sites, usable in the Query Loop block"
msgstr "Berichttype voor veelgestelde vragen die alleen voor leden zichtbaar zijn, te gebruiken in het Query Loop-blok"

#. Author of the plugin
#: wp-soli-faq-plugin.php
msgid "Joran Out"
msgstr "Joran Out"

#. translators: %s: login URL
#: build/search/render.php:30
#, php-format
msgid "The frequently asked questions are for members only. <a href=\"%s\">Log in</a> to read them."
msgstr "De veelgestelde vragen zijn alleen voor leden. <a href=\"%s\">Log in</a> om ze te lezen."

#. translators: %s: login URL
#: build/search/render.php:43
#, php-format
msgid "Some questions are for members only. <a href=\"%s\">Log in</a> to see them all."
msgstr "Een deel van de vragen is alleen voor leden. <a href=\"%s\">Log in</a> om alles te zien."

